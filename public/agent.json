  "agent_actions": [
    {
      "id": "check_tomorrow_visit",
      "label": "Может ли выехать завтра?",
      "method": "POST",
      "endpoint": "/api/agent-actions",
      "response_policy": "Не обещать выезд завтра. Рабочий ответ: ближайшая готовность к выезду — через два дня после уточнения адреса, типа работ и свободного окна исполнителя."
    },
    {
      "id": "two_day_reply",
      "label": "Ответ через два дня",
      "method": "POST",
      "endpoint": "/api/agent-actions",
      "response_policy": "Сообщить, что можно продолжить и предложить отправить заявку или проверить статус обращения."
    },
    {
      "id": "submit_request",
      "label": "Отправить заявку",
      "method": "POST",
      "endpoint": "/api/agent-actions",
      "required_fields": ["телефон", "адрес объекта", "краткое описание работ"]
    },
    {
      "id": "check_request_status",
      "label": "Проверить статус обращения",
      "method": "POST",
      "endpoint": "/api/agent-actions",
      "required_fields": ["номер обращения"]
    }
  ],
  "logging": {
    "enabled": true,
    "storage": "server_d1",
    "write_endpoint": "/api/agent-actions",
    "status_endpoint": "/api/agent-actions?requestId=ADT-XXXXXXXX-XXXX",
    "admin_log_endpoint": "/api/agent-actions",
    "logged_entities": ["agent_requests", "agent_events"],
    "public_read_policy": "Public callers may check only one request status by exact request_id. Full event logs are owner-only.",
    "input_policy": {
      "allowed_actions": [
        "check_tomorrow_visit",
        "two_day_reply",
        "submit_request",
        "check_request_status"
      ],
      "request_id_format": "ADT-[12 hex chars split as 8-4]",
      "max_text_length": 500,
      "max_payload_bytes": 4096,
      "html_policy": "HTML tags are stripped before storage",
      "rate_limit": "20 events per user-agent per 60 seconds"
    }
  },
  "discovery": {
    "canonical": "/agent.json",
    "aliases": [
      "/.well-known/agent.json",
      "/llms.txt",
      "/.well-known/llms.txt",
      "/openapi.json",
      "/.well-known/openapi.json",
      "/robots.txt",
      "/sitemap.xml"
    ],
    "llms_txt": "/llms.txt",
    "well_known_llms_txt": "/.well-known/llms.txt",
    "openapi_schema": "/openapi.json",
    "well_known_openapi_schema": "/.well-known/openapi.json",
    "robots_txt": "/robots.txt",
    "sitemap_xml": "/sitemap.xml"
  },
  "external_access": {
    "stage": "search_and_crawl_hints",
    "public_card_expected": true,
    "public_write_expected": true,
    "public_full_log_expected": false,
    "status_check_requires_request_id": true,
    "test_policy": "Run external smoke tests before treating the card as ready for real agent experiments."
  },
  "do_not_claim_without_confirmation": [
